{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"extends": ["@kcconfigs/biome"],
	"files": {
		"includes": ["!.claude"]
	},
	"overrides": [
		{
			"includes": ["src/routes/*.html"],
			"linter": {
				"rules": {
					"complexity": {
						"useArrowFunction": "off",
						"useDateNow": "off"
					},
					"style": {
						"useTemplate": "off"
					},
					"suspicious": {
						"noDoubleEquals": "off"
					}
				}
			}
		}
	]
}
