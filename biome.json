{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"extends": ["@kcconfigs/biome"],
	"files": {
		"includes": ["!.claude", "!.astro", "!public"]
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					},
					"style": {
						"useConst": "off",
						"useImportType": "off"
					}
				}
			}
		}
	]
}
