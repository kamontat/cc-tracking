---
import "@kcstyles/reset.css"
import "../styles/tokens.css"
import "../styles/app.css"

import type { MessageKey } from "#lib/i18n/catalog"

import { ClientRouter } from "astro:transitions"

interface Props {
	/** The tab title before the bundle runs, in English. */
	title: string
	/** The title's catalog key, which the copy pass translates; a legacy page's `bootstrap` sets it instead. */
	titleKey?: MessageKey | undefined
}

const { title, titleKey } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="robots" content="noindex, nofollow">
		<!--
			Runs before first paint, and again after every ClientRouter swap (data-astro-rerun), since
			a swap takes the next page's <html> attributes and would reset theme, tint and language.
		-->
		<script is:inline data-astro-rerun data-theme-boot>
			try {
				const theme = localStorage.getItem("cc:theme")
				if (theme === "light" || theme === "dark") document.documentElement.setAttribute("data-theme", theme)
			} catch {
				// Storage blocked: leave the theme to the device, as getTheme() does.
			}
			try {
				// The build's tint before first paint; chrome.ts stamps the build's own value after.
				const host = location.hostname
				document.documentElement.setAttribute(
					"data-env",
					host === "localhost" || host === "127.0.0.1"
						? "local"
						: /^pr-\d+-.*workers\.dev$/.test(host)
							? "preview"
							: "production",
				)
			} catch {
				// No location: chrome.ts sets the tint once the bundle runs.
			}
			// The reader's language before first paint, by detectLocale's rule: a saved pick, else
			// the first browser language the app speaks, else Thai. The CSS hides Thai pages'
			// static copy until the copy pass has translated it. A block, so an inline script's
			// bindings stay out of the page's global scope.
			{
				let saved = null
				try {
					saved = localStorage.getItem("cc:lang")
				} catch {
					// Storage blocked: decide from the browser's languages, as detectLocale does.
				}
				let lang = saved === "en" || saved === "th" ? saved : null
				try {
					for (const language of lang ? [] : (navigator?.languages ?? [])) {
						const primary = language.toLowerCase().split("-")[0]
						if (primary === "en" || primary === "th") {
							lang = primary
							break
						}
					}
				} catch {
					// No navigator: fall through to Thai, as detectLocale does with no languages.
				}
				document.documentElement.setAttribute("lang", lang ?? "th")
			}
		</script>
		<title data-i18n-title={titleKey}>{title} — cc-tracking</title>
		<!-- Links swap the next page in without a reload, with a view transition (PRD DD-174). -->
		<ClientRouter />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml">
		<meta name="generator" content={Astro.generator}>
		<script>
			import { loadGtm } from "#lib/gtm"
			import { startCopy } from "#lib/i18n/copy"

			// Inlined at build time; unset (dev, previews, local builds) leaves GTM off.
			loadGtm(import.meta.env.PUBLIC_GTM_ID, document)
			// Static copy ships in English with its key; this puts it in the reader's locale.
			startCopy(document)
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
