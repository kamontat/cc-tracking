---
import type { MessageKey } from "#lib/i18n/catalog"
import type { Tab } from "#lib/ui/tabs"

import SiteHeader from "#components/organisms/SiteHeader.astro"
import TabBar from "#components/organisms/TabBar.astro"
import BaseLayout from "#layouts/BaseLayout.astro"

interface Props {
	/** The tab title before the bundle runs, in English. */
	title: string
	/** The title's catalog key, which the copy pass translates (with the build's mark). */
	titleKey?: MessageKey
	/** The page's place, marked in the header tabs and the bottom bar. */
	tab?: Tab
	/** Classes on `<main>` after `page`, the width a page asks for (`page--narrow`, ...). */
	mainClass?: string
}

const { title, titleKey, tab, mainClass } = Astro.props
---

<!-- The app shell every page shares: the header, the page's own main, and the tab bar. -->
<BaseLayout title={title} titleKey={titleKey}>
	<SiteHeader current={tab} />
	<main class:list={["page", mainClass]} id="page"><slot name="main" /></main>
	<TabBar current={tab} />
	<slot />
</BaseLayout>
