---
import type { MessageKey } from "#lib/i18n/catalog"
import type { Tab } from "#lib/ui/tabs"

import SiteHeader from "#components/organisms/SiteHeader.astro"
import TabBar from "#components/organisms/TabBar.astro"
import BaseLayout from "#layouts/BaseLayout.astro"

interface Props {
	/** The tab title before the bundle runs, in English. */
	title: string
	/**
	 * The title's catalog key, which the copy pass translates (with the build's mark). A legacy
	 * page leaves it out: its `bootstrap` sets the translated title instead.
	 */
	titleKey?: MessageKey
	/**
	 * A legacy page's route, which `onPage` starts (`#lib/ui/spa`): the page's path under
	 * `src/pages/` without `.astro` (`cards`, `card/edit`, `index`), the name its script
	 * registers. A converted page has no route: it renders into `<main>` through the `main` slot.
	 */
	route?: string
	/** The page's place, marked in the header tabs and the bottom bar. */
	tab?: Tab
	/** Classes on `<main>` after `page`, the width a page asks for (`page--narrow`, ...). */
	mainClass?: string
	/** Whether the floating *+ New* menu shows; off where the reader is mid-task (PRD DD-104). */
	fab?: boolean
}

const { title, titleKey, route, tab, mainClass, fab = true } = Astro.props
---

<!-- The app shell every page shares: the header, the page's own main, and the tab bar. -->
<BaseLayout title={title} titleKey={titleKey}>
	<SiteHeader current={tab} />
	<main class:list={["page", mainClass]} id="page" data-route={route}><slot name="main" /></main>
	<TabBar current={tab} fab={fab} />
	<slot />
</BaseLayout>
