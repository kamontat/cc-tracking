---
import ListViewPage from "#components/organisms/ListViewPage.svelte"
import AppLayout from "#layouts/AppLayout.astro"
---

<!-- A saved list, read-only (`?id=`); the list is the reader's data, so the page is an island. -->
<AppLayout title="Saved list" titleKey="title.listView" tab="home" fab={false} mainClass="page--narrow">
	<Fragment slot="main">
		<ListViewPage client:load />
	</Fragment>
</AppLayout>
