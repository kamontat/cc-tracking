---
import type { MessageKey } from "#lib/i18n/catalog"

import Icon from "#components/atoms/Icon.astro"
import { en } from "#lib/i18n/en"

/**
 * A sub page's compact heading (prototype `subHead`): a slim bar that sticks under the app
 * header, with a back link and the page's title. app.css draws it, the same markup as the
 * legacy `subHeader`; it bleeds to the window's edges while its content keeps the page's
 * measure.
 */
interface Props {
	/** The title's catalog key; the copy pass translates it in the browser. */
	titleKey: MessageKey
	/** The page the back link leads to. */
	back: string
}

const { titleKey, back } = Astro.props
---

<div class="sub-header">
	<a data-action="back" href={back} aria-label={en["common.back"]} data-i18n-aria-label="common.back"
		><Icon name="back" /></a
	>
	<h1><span class="sub-header__title" data-i18n={titleKey}>{en[titleKey]}</span></h1>
</div>
