---
import type { MessageKey } from "#lib/i18n/catalog"
import type { PageTab } from "#lib/ui/page-tabs"

import { en } from "#lib/i18n/en"

/**
 * A page's title and its tabs (PRD RD-22): one bar on one rule, the title at the start, a thin
 * divider, then the underlined labels straight after it, the one on show underlined on the bar's
 * rule. Only the labels scroll sideways when they must, never wrapping; the same on every width. Each tab is a link to its own
 * address (RD-29), so Back, a bookmark or a pasted link reaches it; the one on show is marked
 * `aria-current="page"`. Static: every tab is its own page, so which one shows is known when the
 * page is built. Cards' (`CARDS_TABS`), Transactions' and Home's tabs all go through it.
 */
interface Props {
	/** The page's title, a catalog key. */
	title: MessageKey
	/** The tabs' nav name, a catalog key (_Card views_). */
	label: MessageKey
	/** The tabs, in order. */
	tabs: readonly PageTab[]
	/** The address of the tab on show, as one of `tabs` gives it. */
	current: string
}

const { title, label, tabs, current } = Astro.props
---

<div class="page-tabs">
	<h1 class="page-tabs__title" data-i18n={title}>{en[title]}</h1>
	<span class="page-tabs__divider" aria-hidden="true"></span>
	<nav class="page-tabs__nav" aria-label={en[label]} data-i18n-aria-label={label}>
		{tabs.map((tab) => (
			<a href={tab.href} aria-current={tab.href === current ? "page" : undefined}>
				<span data-i18n={tab.label}>{en[tab.label]}</span>
			</a>
		))}
	</nav>
</div>

<style>
	/* One bar on one rule: the title, the divider and the tabs on a line. */
	.page-tabs {
		display: flex;
		flex-direction: row;
		gap: var(--cc-space-3);
		align-items: center;
		min-inline-size: 0;
		border-block-end: var(--cc-border-width) solid var(--cc-border);
	}

	/* `.page-tabs__title`, to outweigh app.css's `.page h1` size. */
	.page-tabs__title {
		flex: none;
		margin: 0;
		font-size: var(--cc-text-xl);
		white-space: nowrap;
	}

	/* A thin upright line, about the title's height. */
	.page-tabs__divider {
		flex: none;
		inline-size: var(--cc-border-width);
		block-size: var(--cc-text-xl);
		background: var(--cc-border);
	}

	/* The underlined labels, scrolling sideways rather than wrapping, reaching down over the
	   bar's rule so the one on show is underlined on it. */
	nav {
		display: flex;
		flex-direction: row;
		flex: 1 1 auto;
		align-self: stretch;
		gap: var(--cc-space-1);
		margin-block-end: calc(-1 * var(--cc-border-width));
		min-inline-size: 0;
		overflow-x: auto;
		scrollbar-width: none;
	}

	/* `:any-link`, to outweigh app.css's own `a:any-link` colour and underline. */
	a:any-link {
		flex: 0 0 auto;
		padding: var(--cc-space-3);
		font-size: var(--cc-text-md);
		font-weight: 650;
		color: var(--cc-text-muted);
		white-space: nowrap;
		text-decoration: none;
		border-block-end: var(--cc-rule-width) solid transparent;
	}

	a:any-link:hover {
		color: var(--cc-text);
		text-decoration: none;
	}

	a[aria-current="page"]:any-link {
		color: var(--cc-text);
		border-block-end-color: var(--cc-accent);
	}

	a:focus-visible {
		outline-offset: calc(-1 * var(--cc-ring-width));
	}

	@media (forced-colors: active) {
		.page-tabs__divider {
			forced-color-adjust: none;
			background: CanvasText;
		}

		a[aria-current="page"] {
			border-block-end-color: Highlight;
		}
	}
</style>
