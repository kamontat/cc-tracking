---
import type { Tab } from "#lib/ui/tabs"

import Tabs from "#components/molecules/Tabs.astro"

interface Props {
	/** The page's place, marked in the bar; none for a page outside the four. */
	current?: Tab | undefined
}

const { current } = Astro.props
---

<!--
	The bottom bar on a phone. The nav is fixed, so this slot has no height: the nav holds still
	between pages itself.
-->
<div id="tabbar"><Tabs variant="bar" current={current} /></div>
